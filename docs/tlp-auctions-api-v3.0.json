{
  "openapi": "3.0.1",
  "info": {
    "title": "TLP Auctions API",
    "description": "RESTful API for EverQuest Time-Locked Progression server auction data.\n\nNON-COMMERCIAL USE ONLY: this API and its data are free for personal, non-commercial use under the PolyForm Noncommercial License. You may not sell, or build paid/commercial products on top of, this API or its data. Please use the bulk endpoints for multi-item lookups and honor rate limits (429 / Retry-After). Licensing inquiries: https://discord.gg/YAtbdBn",
    "contact": { "name": "TLP Auctions (Discord)", "url": "https://discord.gg/YAtbdBn" },
    "license": { "name": "PolyForm Noncommercial 1.0.0", "url": "https://polyformproject.org/licenses/noncommercial/1.0.0" },
    "version": "v3.0"
  },
  "_notes_for_eqforge2": {
    "saved": "2026-07-03, from the swagger at https://tlp-auctions.com/swagger/index.html.",
    "base_url": "https://tlp-auctions.com/api  (apex host; the api. subdomain has a cert-SAN mismatch — do NOT use it). araduneauctions.net is the same service/older domain.",
    "cors": "The API only sends CORS headers for origin https://wangel.github.io. A browser on any other origin (localhost / a fork deploy) is BLOCKED. serve.py proxies /api locally; a public deploy needs a Worker proxy. curl/server-side is unaffected.",
    "server": "This app uses serverName=Frostreaver (only TLP with live data). Servers: Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver.",
    "endpoints_used_by_this_app": {
      "POST /api/prices/bulk": "primary price check — krono-normalized MAD-filtered median over full history, <=10 ids/request, cached 1h/item. Fields: medianPlatPrice, sampleSize, hasData, + top-level kronoRate.",
      "GET /api/sales?searchTerm=&exactMatch=true&serverName=&pageSize=": "recent postings for ONE item (WTS+WTB mixed, newest first). Rate-limited 60/min per IP — interactive use only. Used for Recent Postings modal + the under/over review flags (REVIEW_FETCH=25).",
      "GET /api/krono-prices/{serverName}/windows": "windowed krono->plat (1/2/3/7-day). App takes the freshest window with data (1-day preferred)."
    },
    "endpoints_not_yet_used_worth_knowing": {
      "POST /api/sales/bulk": "RECOMMENDED FOR TOOLS — recent deduped sales for up to 200 ids in ONE request (perItemLimit default 8/max 20, optional isBuy), cached ~5min. Switch the review/recent-asks lookups to this to make PC-All fast + honor 'don't poll per item'.",
      "GET /api/items/catalog?serverName=": "every item-with-sales + krono-normalized median in ONE call (~4k items, cached 1h). Could pre-populate an at-a-glance median in the inventory list.",
      "GET /api/items/search?q=&serverName=&limit=": "resolve item name -> id (collapses dup names to the id that has sales).",
      "GET /api/items/{itemId}/history/{serverName}": "full price history points for one item (for a price chart).",
      "GET /api/prices/pricecheck?serverName=&searchTerm=": "avg buy/sell + 8 most-recent per side."
    },
    "rate_limits": "429 + Retry-After. /api/sales single-search = 60/min per IP. Prefer bulk endpoints."
  },
  "paths": {
    "/api/items/search": { "get": { "tags": ["ItemHistory"], "summary": "Search the item catalog by name. Returns matching items with item id and whether each has sales. Duplicate names collapse to the id that has sales.", "parameters": [ { "name": "q", "in": "query", "description": "Item name (or partial), min 2 characters", "schema": { "type": "string" } }, { "name": "serverName", "in": "query", "description": "Default: Frostreaver", "schema": { "type": "string", "default": "Frostreaver" } }, { "name": "limit", "in": "query", "description": "Max results (1-50). Default: 25", "schema": { "type": "integer", "format": "int32", "default": 25 } } ], "responses": { "200": { "description": "Matching items with id + hasSales", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemSearchResultDto" } } } }, "400": { "description": "Missing/too-short query or invalid server" } } } },
    "/api/items/catalog": { "get": { "tags": ["ItemHistory"], "summary": "Every item that has sales on a server, each with item id, name, and median price (krono-normalized, MAD outlier-filtered). ~4k items, cached 1h.", "parameters": [ { "name": "serverName", "in": "query", "description": "Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver. Default: Frostreaver", "schema": { "type": "string", "default": "Frostreaver" } } ], "responses": { "200": { "description": "All items with sales: itemId, name, median (null if no priced sales)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemCatalogDto" } } } }, "400": { "description": "Invalid server name" } } } },
    "/api/items/{itemId}/history/{serverName}": { "get": { "tags": ["ItemHistory"], "summary": "Price history for a specific item on a server", "parameters": [ { "name": "itemId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }, { "name": "serverName", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Price history, or null if no data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PriceHistoryDto" } } } }, "400": { "description": "Invalid server name" } } } },
    "/api/krono-prices": { "get": { "tags": ["KronoPrices"], "summary": "Krono prices for all servers", "responses": { "200": { "description": "All server krono prices", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AllKronoPricesDto" } } } } } } },
    "/api/krono-prices/{serverName}": { "get": { "tags": ["KronoPrices"], "summary": "Krono price for a specific server", "parameters": [ { "name": "serverName", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Server krono price, or null", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KronoPriceDto" } } } }, "400": { "description": "Invalid server name" } } } },
    "/api/krono-prices/{serverName}/windows": { "get": { "tags": ["KronoPrices"], "summary": "Krono price broken into trailing windows (1, 2, 3, 7 days).", "parameters": [ { "name": "serverName", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Windowed krono prices, or null", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KronoPriceWindowsDto" } } } }, "400": { "description": "Invalid server name" } } } },
    "/api/prices": { "get": { "tags": ["Prices"], "summary": "Average price for an item", "parameters": [ { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } }, { "name": "searchTerm", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Average price", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PriceCheckDto" } } } }, "400": { "description": "Invalid server or missing item" }, "404": { "description": "No price data" } } } },
    "/api/prices/bulk": { "post": { "tags": ["Prices"], "summary": "RECOMMENDED FOR TOOLS. Bulk price check: median effective plat for up to 10 item ids in ONE request. Krono sales converted to plat (plat + krono*kronoRate). Cached 1h/item.", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkPriceCheckRequest" } } } }, "responses": { "200": { "description": "One entry per requested id (HasData=false if no sales)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkPriceCheckDto" } } } }, "400": { "description": "Invalid server, empty list, or >10 ids" } } } },
    "/api/prices/detailed": { "get": { "tags": ["Prices"], "summary": "Detailed price breakdown (buy vs sell) with actual sales records", "parameters": [ { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } }, { "name": "searchTerm", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Detailed price data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DetailedPriceCheckDto" } } } }, "400": { "description": "Invalid server or missing item" }, "404": { "description": "No price data" } } } },
    "/api/prices/pricecheck": { "get": { "tags": ["Prices"], "summary": "Average buy/sell prices + the 8 most recent transactions per side.", "parameters": [ { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } }, { "name": "searchTerm", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PriceCheckResultDto" } } } }, "400": { "description": "Bad Request" }, "404": { "description": "Not Found" } } } },
    "/api/raw-logs/{guid}": { "get": { "tags": ["RawLogs"], "summary": "Raw chat log text by GUID", "parameters": [ { "name": "guid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } } ], "responses": { "200": { "description": "Raw log text", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RawLogDto" } } } }, "400": { "description": "Invalid server or GUID" }, "404": { "description": "Raw log not found" } } } },
    "/api/sales": { "get": { "tags": ["Sales"], "summary": "Paginated sales for a single search / single page (interactive UI search).", "description": "Building a tool/watchlist/tracker? Do NOT poll per item. Use POST /api/sales/bulk (up to 50 ids) or POST /api/prices/bulk. This endpoint is rate-limited 60/min per IP.", "parameters": [ { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } }, { "name": "searchTerm", "in": "query", "description": "Case-insensitive partial match. Min 3 chars; empty = browse all.", "schema": { "type": "string" } }, { "name": "isBuy", "in": "query", "description": "true = WTB, false = WTS, null = both", "schema": { "type": "boolean" } }, { "name": "exactMatch", "in": "query", "schema": { "type": "boolean", "default": false } }, { "name": "page", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 1 } }, { "name": "pageSize", "in": "query", "description": "Default 100, hard-capped at 200.", "schema": { "type": "integer", "format": "int32", "default": 100 } }, { "name": "slots", "in": "query", "description": "Comma list of slots (head, chest, back…) or special types (bags, spells, krono)", "schema": { "type": "string" } }, { "name": "stats", "in": "query", "description": "Comma list of stat filters (ac, hp, mana, haste, damage…)", "schema": { "type": "string" } }, { "name": "classes", "in": "query", "schema": { "type": "string" } }, { "name": "races", "in": "query", "schema": { "type": "string" } }, { "name": "focus", "in": "query", "schema": { "type": "string" } }, { "name": "focusRank", "in": "query", "schema": { "type": "integer", "format": "int32" } }, { "name": "pricedOnly", "in": "query", "schema": { "type": "boolean", "default": false } } ], "responses": { "200": { "description": "Paginated sales", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalesLogDtoPagedResultDto" } } } }, "400": { "description": "Invalid server or parameters" } } } },
    "/api/sales/bulk": { "post": { "tags": ["Sales"], "summary": "RECOMMENDED FOR TOOLS / WATCHLISTS. Recent deduped sales (default 8, max 20) for up to 200 item ids on one server in ONE request. Looks up by id, dedups per item, caches ~5min.", "requestBody": { "description": "Server, item ids, optional per-item limit and WTS/WTB filter", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkRecentSalesRequest" } } } }, "responses": { "200": { "description": "Recent sales per item", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkRecentSalesDto" } } } }, "400": { "description": "Invalid server, missing ids, or too many ids" } } } },
    "/api/sales/{id}": { "get": { "tags": ["Sales"], "summary": "A specific sale by ID", "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }, { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } } ], "responses": { "200": { "description": "Sale details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalesLogDto" } } } }, "404": { "description": "Sale not found" } } } },
    "/api/vendors/{name}/sales": { "get": { "tags": ["Vendors"], "summary": "All sales from a specific vendor/auctioneer", "parameters": [ { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "serverName", "in": "query", "schema": { "type": "string", "default": "Teek" } } ], "responses": { "200": { "description": "Vendor sales", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" } } } } }, "400": { "description": "Invalid server or parameters" } } } }
  },
  "components": {
    "schemas": {
      "AllKronoPricesDto": { "type": "object", "properties": { "prices": { "type": "array", "items": { "$ref": "#/components/schemas/KronoPriceDto" }, "nullable": true }, "lastUpdated": { "type": "string", "format": "date-time" } } },
      "BulkPriceCheckDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "kronoRate": { "type": "number", "format": "double" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/BulkPriceItemDto" }, "nullable": true }, "lastUpdated": { "type": "string", "format": "date-time" } } },
      "BulkPriceCheckRequest": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "itemIds": { "type": "array", "items": { "type": "integer", "format": "int32" }, "nullable": true } } },
      "BulkPriceItemDto": { "type": "object", "properties": { "itemId": { "type": "integer", "format": "int32" }, "item": { "type": "string", "nullable": true }, "medianPlatPrice": { "type": "number", "format": "double" }, "sampleSize": { "type": "integer", "format": "int32" }, "hasData": { "type": "boolean" } } },
      "BulkRecentSalesDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/BulkRecentSalesItemDto" }, "nullable": true }, "lastUpdated": { "type": "string", "format": "date-time" } } },
      "BulkRecentSalesItemDto": { "type": "object", "properties": { "itemId": { "type": "integer", "format": "int32" }, "item": { "type": "string", "nullable": true }, "sales": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" }, "nullable": true } } },
      "BulkRecentSalesRequest": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "itemIds": { "type": "array", "items": { "type": "integer", "format": "int32" }, "nullable": true }, "perItemLimit": { "type": "integer", "format": "int32" }, "isBuy": { "type": "boolean", "nullable": true } } },
      "DetailedPriceCheckDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "item": { "type": "string", "nullable": true }, "buySales": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" }, "nullable": true }, "sellSales": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" }, "nullable": true }, "totalBuySales": { "type": "integer", "format": "int32" }, "totalSellSales": { "type": "integer", "format": "int32" }, "lastUpdated": { "type": "string", "format": "date-time" } } },
      "ItemCatalogDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/ItemCatalogEntryDto" }, "nullable": true } } },
      "ItemCatalogEntryDto": { "type": "object", "properties": { "itemId": { "type": "integer", "format": "int32" }, "name": { "type": "string", "nullable": true }, "price": { "type": "number", "format": "double", "nullable": true } } },
      "ItemSearchItemDto": { "type": "object", "properties": { "itemId": { "type": "integer", "format": "int32" }, "item": { "type": "string", "nullable": true }, "hasSales": { "type": "boolean" } } },
      "ItemSearchResultDto": { "type": "object", "properties": { "query": { "type": "string", "nullable": true }, "serverName": { "type": "string", "nullable": true }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/ItemSearchItemDto" }, "nullable": true } } },
      "KronoPriceDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "averagePrice": { "type": "number", "format": "double" }, "sampleSize": { "type": "integer", "format": "int32" }, "lastUpdated": { "type": "string", "format": "date-time" } } },
      "KronoPriceWindowsDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "windows": { "type": "array", "items": { "$ref": "#/components/schemas/KronoWindowDto" }, "nullable": true }, "lastUpdated": { "type": "string", "format": "date-time" } } },
      "KronoWindowDto": { "type": "object", "properties": { "days": { "type": "integer", "format": "int32" }, "averagePrice": { "type": "number", "format": "double" }, "sampleSize": { "type": "integer", "format": "int32" } } },
      "PriceCheckDto": { "type": "object", "properties": { "serverName": { "type": "string", "nullable": true }, "item": { "type": "string", "nullable": true }, "averagePlatPrice": { "type": "number", "format": "double" }, "averageKronoPrice": { "type": "number", "format": "double" }, "sampleSize": { "type": "integer", "format": "int32" }, "lastUpdated": { "type": "string", "format": "date-time" }, "buyPrices": { "$ref": "#/components/schemas/PriceCheckDto" }, "sellPrices": { "$ref": "#/components/schemas/PriceCheckDto" } } },
      "PriceCheckResultDto": { "type": "object", "properties": { "item": { "type": "string", "nullable": true }, "serverName": { "type": "string", "nullable": true }, "sellAverage": { "type": "number", "format": "double" }, "sellSampleSize": { "type": "integer", "format": "int32" }, "recentSellSales": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" }, "nullable": true }, "buyAverage": { "type": "number", "format": "double" }, "buySampleSize": { "type": "integer", "format": "int32" }, "recentBuySales": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" }, "nullable": true } } },
      "PriceHistoryDto": { "type": "object", "properties": { "itemId": { "type": "integer", "format": "int32" }, "itemName": { "type": "string", "nullable": true }, "points": { "type": "array", "items": { "$ref": "#/components/schemas/PriceHistoryPointDto" }, "nullable": true } } },
      "PriceHistoryPointDto": { "type": "object", "properties": { "datetime": { "type": "string", "format": "date-time" }, "platPrice": { "type": "number", "format": "double" }, "kronoPrice": { "type": "number", "format": "double" }, "isBuy": { "type": "boolean" }, "auctioneer": { "type": "string", "nullable": true } } },
      "ProblemDetails": { "type": "object", "properties": { "type": { "type": "string", "nullable": true }, "title": { "type": "string", "nullable": true }, "status": { "type": "integer", "format": "int32", "nullable": true }, "detail": { "type": "string", "nullable": true }, "instance": { "type": "string", "nullable": true } }, "additionalProperties": {} },
      "RawLogDto": { "type": "object", "properties": { "rawGuid": { "type": "string", "format": "uuid" }, "serverName": { "type": "string", "nullable": true }, "rawText": { "type": "string", "nullable": true }, "createdAt": { "type": "string", "format": "date-time" } } },
      "SalesLogDto": { "type": "object", "properties": { "id": { "type": "integer", "format": "int32" }, "serverName": { "$ref": "#/components/schemas/ServerName" }, "itemId": { "type": "integer", "format": "int32", "nullable": true }, "item": { "type": "string", "nullable": true }, "auctioneer": { "type": "string", "nullable": true }, "transactionType": { "type": "boolean", "description": "true = WTB (buy), false = WTS (sell)" }, "platPrice": { "type": "number", "format": "double" }, "kronoPrice": { "type": "number", "format": "double" }, "datetime": { "type": "string", "format": "date-time" }, "rawGuid": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "SalesLogDtoPagedResultDto": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/SalesLogDto" }, "nullable": true }, "totalCount": { "type": "integer", "format": "int32" }, "page": { "type": "integer", "format": "int32" }, "pageSize": { "type": "integer", "format": "int32" }, "totalPages": { "type": "integer", "format": "int32" }, "singleItem": { "type": "boolean" }, "singleItemId": { "type": "integer", "format": "int32", "nullable": true } } },
      "ServerName": { "enum": [0, 1, 2, 3, 4, 5], "type": "integer", "format": "int32", "description": "0=Teek 1=Yelinak 2=Mischief 3=Thornblade 4=Oakwynd 5=Frostreaver (order per server list; verify against live if it matters)" }
    }
  }
}
